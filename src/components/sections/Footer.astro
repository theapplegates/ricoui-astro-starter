---
import Logo from "@/components/ui/Logo.astro";
import ToTop from "@/components/widgets/ToTop.astro";
import { siteConfig } from "@/config/site.js";

const currentYear = new Date().getFullYear();
const templateVersion = "v1.0.0";
const footerLinks = {
	field: [
		{ name: "Home", url: "/" },
		{ name: "Mission Log", url: "/blog" },
		{ name: "About", url: "/about" },
		{ name: "Contact", url: "/contact" },
	],
	channels: [
		{ name: "RSS", url: "/rss.xml" },
		{ name: "GitHub", url: siteConfig.social.github },
		{ name: "MIT License", url: `${siteConfig.social.github}/blob/main/LICENSE` },
	],
};
---

<section class="mt-20 border-t border-dashed border-primary/15 text-gray-700 dark:border-primary-dark/15 md:mt-32">
	<div class="container mx-auto max-w-7xl px-7 py-12 md:py-16">
		<div class="mb-10 flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
			<div class="max-w-sm">
				<Logo />
				<p class="mt-4 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">
					Dossiers on Bond films and other classified matters — shaken, not stirred, from Charleston, SC.
				</p>
			</div>

			<div class="grid grid-cols-2 gap-8 md:gap-12">
				<div>
					<h4 class="mb-4 text-sm font-semibold text-neutral-800 dark:text-neutral-200">Field Operations</h4>
					<ul class="space-y-3">
						{footerLinks.field.map((link) => <li><a href={link.url} class="text-sm text-neutral-500 transition-colors duration-200 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light">{link.name}</a></li>)}
					</ul>
				</div>
				<div>
					<h4 class="mb-4 text-sm font-semibold text-neutral-800 dark:text-neutral-200">Channels</h4>
					<ul class="space-y-3">
						{footerLinks.channels.map((link) => <li><a href={link.url} class="text-sm text-neutral-500 transition-colors duration-200 hover:text-primary dark:text-neutral-400 dark:hover:text-primary-light">{link.name}</a></li>)}
					</ul>
				</div>
			</div>
		</div>

		<div class="flex flex-col items-center justify-between gap-4 border-t border-dashed border-primary/10 pt-8 dark:border-primary-dark/10 sm:flex-row">
			<p class="text-sm text-neutral-400 dark:text-neutral-500">© {currentYear} {siteConfig.author} · Licensed to blog.</p>
			<div class="flex items-center gap-4">
				<span class="inline-flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500">
					<span class="inline-flex items-center gap-1.5 rounded-md border border-dashed border-primary/30 px-2 py-0.5 text-primary/80"><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>{templateVersion}</span>
					<span>Shaken, not stirred</span>
				</span>
				<a href={siteConfig.social.github} target="_blank" class="text-xs font-medium text-neutral-400 transition-colors hover:text-primary dark:text-neutral-500 dark:hover:text-primary-light">View source</a>
			</div>
		</div>
	</div>
</section>

<ToTop />
