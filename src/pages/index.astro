---
import Layout from "@/layouts/Layout.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig } from "@/config/site";
import {
	BookOpen,
	UserRound,
	GitFork,
	NotebookPen,
	Fingerprint,
} from "@lucide/astro";

const dossiers = [
	{
		film: "Goldfinger",
		year: "1964",
		status: "Filed",
		variant: "primary" as const,
	},
	{
		film: "Casino Royale",
		year: "2006",
		status: "Filed",
		variant: "accent" as const,
	},
	{
		film: "Skyfall",
		year: "2012",
		status: "Filed",
		variant: "primary" as const,
	},
	{
		film: "GoldenEye",
		year: "1995",
		status: "Filed",
		variant: "accent" as const,
	},
	{
		film: "Dr. No",
		year: "1962",
		status: "Filed",
		variant: "primary" as const,
	},
	{
		film: "Moonraker",
		year: "1979",
		status: "Filed",
		variant: "accent" as const,
	},
];

const briefingStats = [
	{ label: "dossiers filed", value: String(dossiers.length).padStart(2, "0") },
	{ label: "martinis consumed (research)", value: "classified" },
	{ label: "cover stories remaining", value: "01" },
];
---

<Layout
	title={siteConfig.title}
	description={siteConfig.meta.description}
	keywords={siteConfig.meta.keywords}
>

	<!-- ═══ HERO ═══════════════════════════════════════════════════ -->
	<section class="relative z-20 site-container pt-16 md:pt-24 lg:pt-32">
		<div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
			<div data-aos="fade-up-xs" data-aos-once="true">
				<div class="mb-6 flex flex-wrap gap-2">
					<Badge variant="primary">Licensed to Blog</Badge>
					<Badge variant="accent">Charleston, SC · Clearance: Public</Badge>
				</div>

				<h1 class="mb-5 max-w-3xl text-4xl leading-tight md:text-5xl lg:text-6xl font-brand">
					The name's Applegate. Paul Applegate.
				</h1>

				<p class="mb-7 max-w-2xl text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
					I review Bond films the way Q issues gadgets — thoroughly, fondly, and with mild concern for the consequences. Villains, cars, one-liners, and every Bond girl, documented in full. Shaken, not stirred.
				</p>

				<div class="flex flex-wrap gap-3">
					<Button url="/blog" type="fill">
						<BookOpen size={16} /> Read the Mission Log
					</Button>
					<Button url="/about">
						<UserRound size={16} /> Agent Profile
					</Button>
					<Button url={siteConfig.social.github} type="outline" target="_blank">
						<GitFork size={16} /> GitHub
					</Button>
				</div>
			</div>

			<!-- Mission-status terminal (dossier readout) -->
			<div class="relative" data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="150">
				<BrowserFrame url="mi6.local · dossier-status">
					<div class="min-h-[340px] bg-neutral-950 p-5 font-mono text-xs">
						<p class="mb-4 text-neutral-500"># MISSION LOG — cleared for declassification</p>
						{dossiers.map((dossier, i) => (
							<div
								class="dossier-line mb-2 flex items-center gap-3 rounded-md border border-neutral-800 bg-neutral-900/60 px-3 py-2"
								style={`--line-delay: ${i * 110}ms`}
							>
								<span class="text-green-400">✓</span>
								<span class="text-primary-light font-semibold w-28 truncate">{dossier.film}</span>
								<span class="text-neutral-400 flex-1">{dossier.year}</span>
								<span class={`rounded px-2 py-0.5 text-[10px] ${dossier.variant === "accent" ? "bg-accent/20 text-accent" : "bg-primary/20 text-primary-light"}`}>{dossier.status}</span>
							</div>
						))}
						<div class="mt-4 rounded border border-dashed border-neutral-700 p-3">
							<p class="text-neutral-500 mb-1">briefing</p>
							{briefingStats.map((stat) => (
								<p class="text-neutral-300">
									{stat.label}: <span class="text-accent">{stat.value}</span>
								</p>
							))}
							<p class="text-neutral-500 mt-2">location: charleston, sc 🍸</p>
						</div>
					</div>
				</BrowserFrame>
			</div>
		</div>
	</section>

	<div class="site-container my-8 border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

	<!-- ═══ LATEST DOSSIERS ════════════════════════════════════════ -->
	<section class="py-16 md:py-24">
		<BlogSection
			title="Latest dossiers"
			description="Fresh field reports from the mission log — one film, one villain, one drink order at a time."
			limit={3}
		/>
	</section>

	<div class="site-container my-4 border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

	<!-- ═══ AGENT TEASER ═══════════════════════════════════════════ -->
	<section class="site-container py-16 md:py-24">
		<div class="rounded-xl border border-dashed border-primary/20 bg-bg-secondary p-7 dark:border-neutral-700 dark:bg-bg-secondary-dark md:p-10">
			<div class="grid items-center gap-8 md:grid-cols-[auto_1fr]">
				<div class="flex justify-center md:justify-start" data-aos="fade-up-xs" data-aos-once="true">
					<div class="grid h-20 w-20 place-items-center rounded-2xl bg-accent/30 text-neutral-800 dark:bg-accent/20 dark:text-neutral-100">
						<Fingerprint class="h-9 w-9" />
					</div>
				</div>
				<div data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="100">
					<div class="mb-3 flex flex-wrap gap-2">
						<Badge variant="primary">Agent Profile</Badge>
						<Badge variant="neutral">Cover story included</Badge>
					</div>
					<h2 class="mb-3 text-2xl font-brand md:text-3xl">Who is this Applegate fellow, anyway?</h2>
					<p class="mb-6 max-w-2xl leading-relaxed text-neutral-600 dark:text-neutral-300">
						A simple man with a complicated film queue. By day, a software developer in Charleston; by night, a self-appointed custodian of the Bond canon — cataloguing gadgets, grading villains, and defending the honour of the shaken martini.
					</p>
					<div class="flex flex-wrap gap-3">
						<Button url="/about" type="fill">
							<UserRound size={16} /> Read the full profile
						</Button>
						<Button url="/contact" type="outline">
							<NotebookPen size={16} /> Contact HQ
						</Button>
					</div>
				</div>
			</div>
		</div>
	</section>

</Layout>

<style>
	.dossier-line {
		animation: line-fade-in 480ms cubic-bezier(0.4, 0, 0.2, 1) backwards;
		animation-delay: var(--line-delay, 0ms);
	}

	@keyframes line-fade-in {
		from {
			opacity: 0;
			transform: translateX(-6px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dossier-line {
			animation: none !important;
		}
	}
</style>
